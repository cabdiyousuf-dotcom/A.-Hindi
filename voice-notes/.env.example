# Copy to .env and fill in. .env is gitignored.

# Required for `vn summarize` / `vn run`.
ANTHROPIC_API_KEY=sk-ant-...

# Where sessions are stored. Default: ~/VoiceNotes
# VN_HOME=/Users/abdiyousuf/VoiceNotes

# How you should be labelled in transcripts (the mic track is always you).
VN_ME=Me

# Whisper model: tiny / base / small / medium / large-v3 / large-v3-turbo
# large-v3-turbo is the best speed/accuracy trade-off on Apple Silicon.
VN_WHISPER_MODEL=large-v3-turbo

# Force a language (ISO code, e.g. en, so, hi, ar). Leave blank to auto-detect.
# Auto-detect is unreliable on code-switched audio — set it if you know.
VN_LANGUAGE=

# Delete raw audio older than this many days when you run `vn prune`.
VN_AUDIO_RETENTION_DAYS=7
